node_modules/
dist/
tmp/
.DS_Store

# Local Python virtualenvs (figure-rendering, PDF tooling, etc.) — never tracked
harness/.venv-figures/
harness/.venv*/

# Cached paper downloads (paywalled and open-access alike — large + potentially
# copyright-sensitive; the scrape/download scripts regenerate them on demand)
harness/arxiviq_subscription_download/
harness/*_scrape/

# Scraper auth cookie jars — contain live session credentials, never track
harness/*_cookies.txt

# Scratch / scratch-rendering directories — regenerated by the render scripts
harness/tmp_pdf_pages/
harness/render_check/

# HALO-X run state / capture artifacts (generated)
.halo-x/

# Council deliberation transcripts (generated at runtime)
deliberations/

# Local Claude Code session state (handoffs, jobs) — never tracked
.claude/


# Ignore all files in the .idea folder
.idea/

# Except these files, which can be shared
!.idea/workspace.xml
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml
!.idea/libraries/

# Ignore IDE-specific settings that should remain local
.idea/dictionaries/
.idea/inspectionProfiles/
.idea/shelf/
.idea/tasks/
.idea/httpRequests/

# Ignore logs and caches
.idea/dataSources/
.idea/dataSources.local/
.idea/sqlDataSources.xml
.idea/dataSources.ids
.idea/caches/
.idea/jsLibraryMappings.xml

# Ignore project-specific files generated by plugins
.idea/**/target/
.idea/**/out/
.idea/**/build/

# Ignore custom settings for run/debug configurations
.idea/runConfigurations/